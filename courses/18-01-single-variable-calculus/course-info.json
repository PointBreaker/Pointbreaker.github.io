  "summary": "MIT 18.01 单变量微积分，覆盖极限、导数、导数应用、定积分、积分技巧与无穷级数。",
  "coreQuestion": "当局部变化率可计算时，怎样把它累积成可预测的整体行为？",
  "contractTitle": "从直觉到可证明",
  "contractCopy": "每一步计算都回到图像、定义与可检查的边界。",
  "learningSteps": [
    {"title": "建立图像", "description": "把极限、导数和积分放回变化率与面积的直觉。"},
    {"title": "沿定义推导", "description": "从切线、近似或 Riemann 和逐步核对每个条件。"},
    {"title": "用问题验证", "description": "在最值、运动与微分方程中检查模型能否迁移。"}
