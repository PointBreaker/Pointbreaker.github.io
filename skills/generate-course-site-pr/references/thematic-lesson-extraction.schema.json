{
  "type": "object",
  "properties": {
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "number": {"type": "integer", "minimum": 1},
          "titleEn": {"type": "string"},
          "titleZh": {"type": "string"},
          "ledeZh": {"type": "string"},
          "estimatedMinutes": {"type": "integer", "minimum": 15, "maximum": 180},
          "difficultyZh": {"type": "string"},
          "sourceFiles": {"type": "array", "items": {"type": "string"}},
          "objectivesZh": {"type": "array", "minItems": 3, "maxItems": 6, "items": {"type": "string"}},
          "prerequisitesZh": {"type": "array", "maxItems": 6, "items": {"type": "string"}},
          "sections": {
            "type": "array",
            "minItems": 3,
            "maxItems": 8,
            "items": {
              "type": "object",
              "properties": {
                "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
                "titleZh": {"type": "string"},
                "bodyMarkdown": {"type": "string"},
                "workedExampleMarkdown": {"type": "string"}
              },
              "required": ["id", "titleZh", "bodyMarkdown", "workedExampleMarkdown"],
              "additionalProperties": false
            }
          },
          "misconceptions": {
            "type": "array",
            "minItems": 2,
            "maxItems": 5,
            "items": {
              "type": "object",
              "properties": {
                "claimZh": {"type": "string"},
                "correctionZh": {"type": "string"}
              },
              "required": ["claimZh", "correctionZh"],
              "additionalProperties": false
            }
          },
          "quizzes": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "object",
              "properties": {
                "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
                "questionZh": {"type": "string"},
                "choices": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 5,
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {"type": "string", "pattern": "^[a-e]$"},
                      "textZh": {"type": "string"}
                    },
                    "required": ["id", "textZh"],
                    "additionalProperties": false
                  }
                },
                "answer": {"type": "string", "pattern": "^[a-e]$"},
                "correctFeedbackZh": {"type": "string"},
                "incorrectFeedbackZh": {"type": "string"}
              },
              "required": ["id", "questionZh", "choices", "answer", "correctFeedbackZh", "incorrectFeedbackZh"],
              "additionalProperties": false
            }
          },
          "recapZh": {"type": "array", "minItems": 3, "maxItems": 7, "items": {"type": "string"}},
          "references": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/evidence"}
          }
        },
        "required": ["number", "titleEn", "titleZh", "ledeZh", "estimatedMinutes", "difficultyZh", "sourceFiles", "objectivesZh", "prerequisitesZh", "sections", "misconceptions", "quizzes", "recapZh", "references"],
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "properties": {
        "value": {"type": "string"},
        "sourceFile": {"type": "string"},
        "pageOrSlide": {"type": "string"},
        "evidence": {"type": "string"},
        "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
        "conflictGroup": {"type": ["string", "null"]}
      },
      "required": ["value", "sourceFile", "pageOrSlide", "evidence", "confidence", "conflictGroup"],
      "additionalProperties": false
    }
  },
  "required": ["modules"],
  "additionalProperties": false
}
