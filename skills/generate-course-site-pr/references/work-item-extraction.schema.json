{
  "type": "object",
  "properties": {
    "batch": {"type": "string"},
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {"type": "string", "enum": ["Discussion", "Homework", "Assignment", "Lab"]},
          "number": {
            "anyOf": [
              {"type": "integer", "minimum": 0},
              {"type": "string", "minLength": 1}
            ]
          },
          "titleEn": {"type": "string"},
          "titleZh": {"type": "string"},
          "summaryZh": {"type": "string"},
          "sourceFiles": {"type": "array", "items": {"type": "string"}},
          "solutionSourceFiles": {"type": "array", "items": {"type": "string"}},
          "topicKeywords": {"type": "array", "items": {"type": "string"}},
          "suggestedDependsOn": {"type": "array", "items": {"type": "integer", "minimum": 1}},
          "documentEvidence": {"$ref": "#/$defs/evidence"},
          "problems": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {"type": "string"},
                "titleZh": {"type": "string"},
                "statementMarkdown": {"type": "string"},
                "hintMarkdown": {"type": "string"},
                "solutionMarkdown": {"type": "string"},
                "solutionStatus": {"type": "string", "enum": ["official", "no-local-solution"]},
                "questionEvidence": {"$ref": "#/$defs/evidence"},
                "solutionEvidence": {
                  "anyOf": [{"type": "null"}, {"$ref": "#/$defs/evidence"}]
                },
                "visualRequirements": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "kind": {"type": "string", "enum": ["table", "diagram", "pipeline", "graph", "matrix", "none"]},
                      "sourceFile": {"type": "string"},
                      "pageOrSlide": {"type": "string"},
                      "descriptionZh": {"type": "string"},
                      "requiredDataMarkdown": {"type": "string"},
                      "interactiveCandidate": {"type": "boolean"},
                      "reasonZh": {"type": "string"}
                    },
                    "required": ["kind", "sourceFile", "pageOrSlide", "descriptionZh", "requiredDataMarkdown", "interactiveCandidate", "reasonZh"],
                    "additionalProperties": false
                  }
                }
              },
              "required": ["id", "titleZh", "statementMarkdown", "hintMarkdown", "solutionMarkdown", "solutionStatus", "questionEvidence", "solutionEvidence", "visualRequirements"],
              "additionalProperties": false
            }
          }
        },
        "required": ["kind", "number", "titleEn", "titleZh", "summaryZh", "sourceFiles", "solutionSourceFiles", "topicKeywords", "suggestedDependsOn", "documentEvidence", "problems"],
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "properties": {
        "value": {"type": "string"},
        "sourceFile": {"type": "string"},
        "pageOrSlide": {"type": "string"},
        "evidence": {"type": "string"},
        "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
        "conflictGroup": {"type": ["string", "null"]}
      },
      "required": ["value", "sourceFile", "pageOrSlide", "evidence", "confidence", "conflictGroup"],
      "additionalProperties": false
    }
  },
  "required": ["batch", "documents"],
  "additionalProperties": false
}
